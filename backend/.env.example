# ── Environment ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite fallback — default if DATABASE_URL is unset):
DATABASE_URL=sqlite+aiosqlite:///./fertilizer_rec_dev.db

# Production / staging: PostgreSQL (asyncpg). Do not commit real credentials.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/fertilizer_rec

# SQLAlchemy query echo (set True only for debugging — very verbose)
DB_ECHO=false

# PostgreSQL connection pool size (ignored for SQLite)
DB_POOL_SIZE=5

# ── Application ───────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
APP_VERSION=0.2.0
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins, or a JSON list. Do not use "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODEL_DIR=../ml/models
ML_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Process bind address (set by the host; uvicorn reads --port, not this file)
# PORT=8000
