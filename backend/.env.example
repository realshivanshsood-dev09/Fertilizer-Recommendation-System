# ── Environment ──────────────────────────────────────────────────────────────
# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fertilizer_rec
# Fallback for local dev (uncomment to use SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./fertilizer_rec_dev.db

# Application
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY

# ML
ML_MODEL_DIR=../ml/models
ML_ENABLED=false

# Logging
LOG_LEVEL=INFO
